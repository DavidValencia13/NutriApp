PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/nutriapp
POSTGRES_DB=nutriapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
# Obligatoria: el servidor no arranca sin ella. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=20000
GROQ_REASONING_EFFORT=low
GROQ_MAX_COMPLETION_TOKENS=5500
GROQ_API_KEY=tu_groq_api_key_aqui

# Búsqueda automática de información nutricional (USDA FoodData Central).
# Key gratuita: https://fdc.nal.usda.gov/api-key-signup
USDA_FDC_API_KEY=
USDA_FDC_TIMEOUT_MS=10000

# ── Inteligencia artificial ───────────────────────────────────────────────────
# Proveedor para TODO lo que usa IA: asistente, generación de menús y
# traducción de alimentos para buscarlos en USDA.
# Opciones: "groq" (default, usa GPT-OSS 120b) | "anthropic" (Claude)
IA_PROVIDER=groq

# Solo necesario cuando IA_PROVIDER=anthropic. La llave se crea en
# https://console.anthropic.com (API Keys); se paga por uso con saldo prepago.
ANTHROPIC_API_KEY=
# Modelo para el asistente y la traducción de alimentos. claude-haiku-5-5 es
# el más económico (~$0.0008 por mensaje del chat, ~$0.0001 por traducción).
ANTHROPIC_MODEL=claude-haiku-5-5
# Modelo para generar menús (si se deja vacío: claude-sonnet-5-5, ~$0.04 por
# menú). Haiku es más barato pero arma platos menos coherentes.
ANTHROPIC_MODEL_MENU=
# Los menús se generan sin razonamiento (más rápido y barato). Solo los
# modelos que no permiten apagarlo (ej. claude-opus-5-5) usan este esfuerzo:
# low (default) | medium | high
ANTHROPIC_EFFORT_MENU=low
ANTHROPIC_TIMEOUT_MS=30000
ANTHROPIC_TIMEOUT_MENU_MS=120000
