PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/nutriapp
POSTGRES_DB=nutriapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
JWT_SECRET=

GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=20000
GROQ_API_KEY=tu_groq_api_key_aqui

# Búsqueda automática de información nutricional (USDA FoodData Central).
# Key gratuita: https://fdc.nal.usda.gov/api-key-signup
USDA_FDC_API_KEY=
USDA_FDC_TIMEOUT_MS=10000

# ── Asistente IA ──────────────────────────────────────────────────────────────
# Selecciona el proveedor de IA para el módulo Asistente.
# Opciones: "groq" (default, usa LLaMA 3.3 70b) | "anthropic" (Claude)
IA_PROVIDER=groq

# Solo necesario cuando IA_PROVIDER=anthropic
# Modelo recomendado para el asistente: claude-haiku-5-5 (balance costo/calidad)
# Alternativa más potente para análisis clínico: claude-sonnet-5-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_TIMEOUT_MS=30000
